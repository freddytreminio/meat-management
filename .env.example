# Exclusivamente desarrollo local. No reutilizar credenciales de Neon.
POSTGRES_USER=meat_local
POSTGRES_PASSWORD=meat_local_dev_only
POSTGRES_DB=meat_management
# Para comandos Drizzle ejecutados desde el host, no desde Docker.
DATABASE_URL=postgresql://meat_local:meat_local_dev_only@localhost:5432/meat_management
# Genera los valores privados mediante node scripts/setup-local.mjs.
BETTER_AUTH_SECRET=
AUTH_ORIGIN=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@meat.local
BOOTSTRAP_ADMIN_PASSWORD=
