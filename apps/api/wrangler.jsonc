{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meat-management-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "send_metrics": false,
  "env": {
    "production": {
      "name": "meat-management-api-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "AUTH_ORIGIN": "https://meat-management.pages.dev",
      },
    },
  },
}
